    {
      "id": "57559d3a-9be2-496d-b8c6-3f09643f9a59",
      "name": "Collect Intel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Combine rating + homepage text per competitor and build ONE Gemini prompt\nconst list = $('Competitor List').all();\nconst tp = $('Trustpilot (competitor)').all();\nconst hp = $('Homepage (competitor)').all();\nconst base = [];\nconst blocks = [];\nfor (let i = 0; i < list.length; i++) {\n  const domain = list[i].json.domain;\n  const tpText = ((tp[i] && tp[i].json.data) || '').toString();\n  const hpText = ((hp[i] && hp[i].json.data) || '').toString();\n  let rating = null;\n  const head = tpText.slice(0, 300);\n  const k = head.indexOf(' with ');\n  if (k >= 0) {\n    const m = head.slice(k, k + 20).match(/[0-9][.][0-9]|[0-9]/);\n    if (m) rating = parseFloat(m[0]);\n  }\n  const siteUp = hpText.length > 200;\n  base.push({ domain, rating, site_up: siteUp });\n  const snippet = hpText.split('](').join(' ').slice(0, 1800);\n  blocks.push('### ' + domain + '\\n' + (snippet || '(no content)'));\n}\nconst brand = $('⚙️ CONFIG (Competitors)').first().json.brandName;\nconst prompt = 'You are a competitive-intelligence analyst for ' + brand + ', a proprietary trading firm. Below is scraped homepage text for competitor prop firms. For EACH competitor return its current headline offer (discounts, profit split, payout speed, promo codes) in max 25 words, whether a time-limited promotion is visible, and one short note that matters to a rival. Return STRICT JSON only: an array of objects with keys domain, offer_summary, promo_detected (boolean), notes.\\n\\n' + blocks.join('\\n\\n');\nreturn [{ json: { prompt, base } }];"
      }
    },
    {
      "id": "0038a739-2b55-40a1-b94b-2259b40fe7ab",
      "name": "🤖 Gemini: Competitor Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        80
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/{{ $('⚙️ CONFIG (Competitors)').first().json.geminiModel }}:generateContent?key={{ $('⚙️ CONFIG (Competitors)').first().json.geminiApiKey }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: $json.prompt }] }], generationConfig: { temperature: 0.3, maxOutputTokens: 4096, responseMimeType: \"application/json\", thinkingConfig: { thinkingBudget: 0 } } }) }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "99056a7d-e30e-4e5e-a856-ab649eede73a",
      "name": "Merge Intel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Parse Gemini's JSON array and merge it with the ratings\nlet raw = '';\ntry { raw = $json.candidates[0].content.parts[0].text || ''; } catch (e) {}\nraw = raw.split('```json').join('').split('```').join('').trim();\nlet arr = [];\ntry { arr = JSON.parse(raw); } catch (e) {\n  const a = raw.indexOf('['); const b = raw.lastIndexOf(']');\n  if (a >= 0 && b > a) { try { arr = JSON.parse(raw.slice(a, b + 1)); } catch (e2) {} }\n}\nconst base = $('Collect Intel').first().json.base;\nconst items = base.map(b => {\n  const ai = (Array.isArray(arr) ? arr : []).find(x => x && x.domain && b.domain.indexOf(String(x.domain).replace('www.', '')) >= 0) || {};\n  return {\n    domain: b.domain,\n    trustpilot_rating: b.rating,\n    site_up: b.site_up,\n    offer_summary: ai.offer_summary || '(no offer detected)',\n    promo_detected: !!ai.promo_detected,\n    notes: ai.notes || ''\n  };\n});\nreturn [{ json: { type: 'competitor_batch', items } }];"
      }
    },
