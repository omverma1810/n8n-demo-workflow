    {
      "id": "1eb08b0e-97b8-4f0e-899f-2ac6e56528d5",
      "name": "Competitor List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Split the configured competitor domains into one item each\nconst raw = $('⚙️ CONFIG (Competitors)').first().json.competitors || '';\nconst domains = raw.split(',').map(d => d.trim()).filter(Boolean);\nreturn domains.map(domain => ({ json: { domain } }));"
      }
    },
