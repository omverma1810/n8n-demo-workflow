    {
      "id": "272c258c-4dc8-46aa-9100-53a0a6028ad2",
      "name": "Parse Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        520
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Telegram button press -> decision\nconst cb = $json.callback_query;\nif (!cb || !cb.data) return [];\nconst parts = String(cb.data).split(':');\nconst action = parts[0];\nconst id = Number(parts[1]);\nif (!['approve', 'reject'].includes(action) || !id) return [];\nreturn [{ json: {\n  decision: action === 'approve' ? 'approved' : 'rejected',\n  id,\n  queryId: cb.id,\n  by: (cb.from && (cb.from.username || cb.from.first_name)) || 'telegram'\n} }];"
      }
    },
    {
      "id": "141b9d1e-6157-4539-a60d-fbd7a7d09c5a",
      "name": "💬 Telegram: Ack Button",
      "type": "n8n-nodes-base.telegram",
