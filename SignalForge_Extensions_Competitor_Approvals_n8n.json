    {
      "id": "6060aabe-7124-4b6a-bd65-d439768e732b",
      "name": "Build Competitor Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Turn the dashboard's change report into a human digest\nconst r = $json && $json.changes ? $json : { changes: [], anyChanged: false };\nconst lines = r.changes.map(c => {\n  const arrow = c.delta > 0 ? ' (+' + c.delta + ')' : c.delta < 0 ? ' (' + c.delta + ')' : '';\n  const flag = !c.firstSeen && c.changed ? '🚨 ' : '• ';\n  return flag + c.domain + ' — rating ' + (c.rating || 'n/a') + arrow + (c.promo_detected ? ' · PROMO' : '') + '\\n   ' + c.offer_summary;\n});\nconst title = r.anyChanged ? '🚨 Competitor changes detected' : '🔭 Competitor watch — daily digest';\nreturn [{ json: { anyChanged: !!r.anyChanged, text: title + '\\n\\n' + (lines.join('\\n\\n') || 'No data returned.') } }];"
      }
    },
