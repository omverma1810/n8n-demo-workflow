    {
      "id": "080d04d8-2724-4c85-88d6-ecc3db201bca",
      "name": "Build Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        520
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Build the confirmation message after the dashboard recorded the decision\nconst r = $json || {};\nconst d = $('Parse Decision').first().json;\nconst post = r.post || {};\nlet text;\nlet notify = false;\nif (!r.ok) { text = '⚠️ Could not record the decision for post #' + d.id + ' (' + (r.error || 'dashboard unreachable') + ').'; }\nelse if (r.alreadyDecided) { text = 'ℹ️ Post #' + d.id + ' was already ' + post.status + '.'; }\nelse if (d.decision === 'approved') { text = '✅ Approved post #' + d.id + ' (' + post.platform + '). Final copy emailed to the team.'; notify = true; }\nelse { text = '❌ Rejected post #' + d.id + ' (' + post.platform + '). It will not be published.'; }\nreturn [{ json: { text, notify, id: d.id, platform: post.platform || '', content: post.content || '', by: d.by } }];"
      }
